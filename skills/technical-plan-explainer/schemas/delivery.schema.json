{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Technical plan explainer delivery v1",
  "type":"object",
  "required":["schema_version","title","duration","composition","script","sources","storyboard","cues","voice","media","chapters","key_cues"],
  "properties":{
    "schema_version":{"const":1},"title":{"type":"string","minLength":1},"duration":{"type":"number","exclusiveMinimum":0},
    "composition":{"type":"string","minLength":1},"script":{"type":"string","minLength":1},"sources":{"type":"string","minLength":1},"storyboard":{"type":"string","minLength":1},"cues":{"type":"string","minLength":1},"native_check":{"type":"string"},
    "voice":{"type":"object","required":["profile_id","reference_sha256","model"],"properties":{"profile_id":{"const":"cove-reference-v1"},"reference_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"model":{"const":"seed-audio-1.0"}}},
    "media":{"type":"array","minItems":1,"items":{"type":"object","required":["id","path","start","duration","task_id","profile_id","reference_sha256","model","sample_rate","speech_rate","pitch_rate"],"properties":{"id":{"type":"string","minLength":1},"path":{"type":"string"},"start":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0},"sample_rate":{"const":24000},"speech_rate":{"const":0},"pitch_rate":{"const":0}}}},
    "chapters":{"type":"array","minItems":1,"items":{"type":"object","required":["title","start","summary","source_refs"],"properties":{"title":{"type":"string"},"start":{"type":"number","minimum":0},"summary":{"type":"string"},"source_refs":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
    "key_cues":{"type":"array","minItems":1,"items":{"type":"object","required":["scene_id","action","audio_phrase","word_start","motion_start","source_ref"],"properties":{"scene_id":{"type":"string"},"word_start":{"type":"number","minimum":0},"motion_start":{"type":"number","minimum":0},"source_ref":{"type":"string"}}}},
    "glossary":{"type":"array","items":{"type":"object","required":["term","definition"]}}
  }
}
